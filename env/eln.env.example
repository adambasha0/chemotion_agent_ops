# Copy to env/eln.env and edit. Gitignored. Dev credentials only, on a database
# copy you created — never a real account, never a shared database.
#
# Values are read literally: the <placeholders> and /path/to/ below are NOT
# expanded or resolved. Write out the real values.

# --- which instance a flow drives ----------------------------------------
# dokploy : a deployed instance (preferred — no stack to boot, and a
#           GitHub-hosted runner can drive it)
# local   : docker compose on this machine (the fallback, and what you want
#           while iterating on a flow)
ELN_PROVIDER=dokploy

# The URL the browser opens. For dokploy, the deployment's own host.
ELN_BASE=https://<initials>-eln-deploy.<your-dokploy-suffix>

# How `rails runner` reaches the app, for fixtures. One argument: a shell line.
# local   : docker exec -i <container> bash -lc        (the default)
# dokploy : ssh <host> docker exec -i <container> bash -lc
# Leave it unset for local. A deployed instance you have no shell on cannot be
# seeded this way; such a flow must build its state through the app's own API
# and say so.
# ELN_EXEC=ssh <dokploy-host> docker exec -i <app container> bash -lc

# --- dokploy -------------------------------------------------------------
# A token, not a password. Create it in Dokploy under your profile; it is the
# credential the workflow holds, so scope it to the project if you can.
DOKPLOY_URL=https://<your-dokploy-host>
DOKPLOY_TOKEN=
# The app names as Dokploy shows them under the service title, not the titles.
DOKPLOY_ELN_APP=
DOKPLOY_SAURUS_APP=

# --- local provider only -------------------------------------------------
ELN_APP_CONTAINER=chemotion_capture-app-1
ELN_DEV_SERVER_PORT=3036

# --- the tree it serves ---------------------------------------------------
# A worktree, never the primary checkout: a flow that checks out a ref would
# otherwise move the branch another session is working on.
ELN_REPO=/path/to/chemotion_ELN
ELN_TREE=/path/to/chemotion_ELN/tmp/wt-capture
ELN_BRANCH=main

# --- the database ---------------------------------------------------------
# SOURCE is read, never written. DB is a pg_dump copy of it.
ELN_PG_CONTAINER=chemotion_eln-postgres-1
ELN_SOURCE_DB=chemotion_dev
ELN_DB=chemotion_capture
ELN_HOMEDIR_VOLUME=chemotion_capture_homedir
ELN_SOURCE_VOLUME=chemotion_eln_homedir_resource_test
ELN_NETWORK=chemotion_eln_default

# --- pacing (optional) ---------------------------------------------------
# Milliseconds. Defaults: the pointer sits 1500 on a control before pressing,
# the effect renders for 600, the screen holds 1500 before the next move.
# CAPTURE_STILL_BUDGET is a FRAME count at 12 fps and must stay above
# CAPTURE_PAUSE_AFTER, or the trim clips every pause the pacing asks for —
# the harness refuses to start if it does not.
# CAPTURE_PAUSE_BEFORE=1500
# CAPTURE_SETTLE=600
# CAPTURE_PAUSE_AFTER=1500
# CAPTURE_STILL_BUDGET=26
# CAPTURE_TAIL_HOLD=30

# --- logins the flows use -------------------------------------------------
ELN_ADMIN_LOGIN=ADM
ELN_ADMIN_PASSWORD=
ELN_USER_LOGIN=CU1
ELN_USER_PASSWORD=

# --- the docs repo --------------------------------------------------------
SAURUS_REPO=/path/to/chemotion_saurus
